(in-package :anvil)

;;
;; The REST API, /api/v4, in GitLab's names and shapes: the subset that
;; the programs around common-lisp.net use (the prompt lab, the git
;; gate, the sites that fetch an artifact), plus what a person would
;; expect beside them.  ARCHITECTURE.md lists the endpoints.
;;

(defparameter *project-resources*
  '("repository" "issues" "merge_requests" "pipelines" "pipeline" "jobs" "variables" "hooks" "members" "star" "unstar"
    "deployments" "languages" "statistics" "labels" "releases" "protected_branches")
  "The words that end a project's path in /api/v4/projects/<path>/...")

;;; JSON shapes

(defun user-json (user &key full?)
  (when user
    (let ((table (json-table "id" (getf user :id) "username" (getf user :username) "name" (user-display user)
                             "state" (status-text (getf user :state))
                             "avatar_url" :null "web_url" (strcat *site-url* (user-url user)))))
      (when full?
        (setf (gethash "email" table) (getf user :email)
              (gethash "is_admin" table) (json-boolean (getf user :admin?))
              (gethash "created_at" table) (iso-timestamp-ms (getf user :created))
              (gethash "bio" table) (or (getf user :bio) "")))
      table)))

(defun namespace-json (project)
  (multiple-value-bind (namespace kind) (project-namespace project)
    (json-table "id" (getf namespace :id) "name" (namespace-name namespace kind)
                "path" (ecase kind (:group (getf namespace :path)) (:user (getf namespace :username)))
                "kind" (string-downcase (symbol-name kind))
                "full_path" (namespace-path namespace kind)
                "web_url" (strcat *site-url* "/" (namespace-path namespace kind)))))

(defun project-json (project &key simple?)
  (let* ((repository (ignore-errors (project-repository project)))
         (empty? (or (null repository) (null (ingot:head-oid repository))))
         (table (json-table "id" (getf project :id)
                            "description" (getf project :description)
                            "name" (getf project :name)
                            "name_with_namespace" (format nil "~a / ~a" (project-namespace-path project) (getf project :name))
                            "path" (getf project :path)
                            "path_with_namespace" (getf project :path-with-namespace)
                            "created_at" (iso-timestamp-ms (getf project :created))
                            "default_branch" (getf project :default-branch)
                            "tag_list" #() "topics" #()
                            "ssh_url_to_repo" :null
                            "http_url_to_repo" (project-clone-url project)
                            "web_url" (project-web-url project)
                            "readme_url" :null
                            "avatar_url" :null
                            "forks_count" 0
                            "star_count" (or (getf project :star-count) 0)
                            "last_activity_at" (iso-timestamp-ms (or (getf project :last-activity) (getf project :created)))
                            "namespace" (namespace-json project)
                            "visibility" (string-downcase (symbol-name (getf project :visibility))))))
    (unless simple?
      (setf (gethash "empty_repo" table) (json-boolean empty?)
            (gethash "archived" table) (json-boolean (getf project :archived?))
            (gethash "issues_enabled" table) (json-boolean (getf project :issues-enabled? t))
            (gethash "merge_requests_enabled" table) (json-boolean (getf project :merge-requests-enabled? t))
            (gethash "jobs_enabled" table) (json-boolean (getf project :ci-enabled? t))
            (gethash "container_registry_image_prefix" table) ""
            (gethash "mirror" table) (json-boolean (and (project-pull-mirror project) t))
            (gethash "import_url" table) (let ((mirror (project-pull-mirror project))) (if mirror (getf mirror :url) :null))
            (gethash "import_status" table) (let ((mirror (project-pull-mirror project)))
                                                 (cond ((null mirror) "none") ((null (getf mirror :last-at)) "scheduled")
                                                       ((getf mirror :last-ok?) "finished") (t "failed")))
            (gethash "import_error" table) (let ((mirror (project-pull-mirror project)))
                                                (if (and mirror (getf mirror :last-at) (not (getf mirror :last-ok?))) (getf mirror :last-note) :null))
            (gethash "open_issues_count" table) (length (project-issues project))
            (gethash "permissions" table) (json-table "project_access"
                                                      (let ((level (project-access-level project)))
                                                        (if level (json-table "access_level" level) :null))
                                                      "group_access" :null)))
    table))

(defun commit-json (project commit &key stats)
  (let ((table (json-table "id" (ingot:commit-oid commit)
                           "short_id" (subseq (ingot:commit-oid commit) 0 8)
                           "title" (ingot:commit-subject commit)
                           "message" (ingot:commit-message commit)
                           "author_name" (ingot:commit-author-name commit)
                           "author_email" (ingot:commit-author-email commit)
                           "authored_date" (iso-timestamp-ms (git-time-universal (ingot:commit-author commit)))
                           "committer_name" (ingot:ident-name (ingot:commit-committer commit))
                           "committer_email" (ingot:ident-email (ingot:commit-committer commit))
                           "committed_date" (iso-timestamp-ms (git-time-universal (ingot:commit-committer commit)))
                           "created_at" (iso-timestamp-ms (git-time-universal (ingot:commit-committer commit)))
                           "parent_ids" (coerce (ingot:commit-parents commit) 'vector)
                           "web_url" (format nil "~a/-/commit/~a" (project-web-url project) (ingot:commit-oid commit)))))
    (when stats (setf (gethash "stats" table) stats))
    table))

(defun branch-json (project repository name oid)
  (let ((commit (ingot:read-commit repository oid)))
    (json-table "name" name
                "commit" (commit-json project commit)
                "merged" (json-boolean (and (not (string= name (getf project :default-branch)))
                                            (let ((head (ingot:resolve-commit repository (getf project :default-branch))))
                                              (and head (ingot:ancestor? repository oid head)))))
                "protected" (json-boolean (protected-branch? project name))
                "default" (json-boolean (string= name (getf project :default-branch)))
                "developers_can_push" (json-boolean (not (protected-branch? project name)))
                "developers_can_merge" (json-boolean (not (protected-branch? project name)))
                "can_push" (json-boolean (can-push-branch? project name))
                "web_url" (format nil "~a/-/tree/~a" (project-web-url project) (url-encode name)))))

(defun tree-entry-json (entry path)
  (json-table "id" (ingot:tree-entry-oid entry)
              "name" (ingot:tree-entry-name entry)
              "type" (if (ingot::tree-entry-tree? entry) "tree" (if (eq (ingot:tree-entry-kind entry) :submodule) "commit" "blob"))
              "path" path
              "mode" (let ((mode (ingot:tree-entry-mode entry))) (if (= (length mode) 5) (strcat "0" mode) mode))))

(defun note-json (note)
  (json-table "id" (getf note :id) "body" (getf note :body)
              "author" (or (user-json (record :user (getf note :author-id))) :null)
              "created_at" (iso-timestamp-ms (getf note :created))
              "system" (json-boolean (getf note :system?))))

(defun issue-json (project issue)
  (json-table "id" (getf issue :id) "iid" (getf issue :iid) "project_id" (getf project :id)
              "title" (getf issue :title) "description" (getf issue :description)
              "state" (status-text (getf issue :state))
              "created_at" (iso-timestamp-ms (getf issue :created))
              "updated_at" (iso-timestamp-ms (or (getf issue :updated) (getf issue :created)))
              "closed_at" (if (getf issue :closed-at) (iso-timestamp-ms (getf issue :closed-at)) :null)
              "labels" (coerce (getf issue :labels) 'vector)
              "milestone" (or (getf issue :milestone) :null)
              "author" (or (user-json (record :user (getf issue :author-id))) :null)
              "assignee" (or (user-json (record :user (getf issue :assignee-id))) :null)
              "assignees" (coerce (remove nil (list (user-json (record :user (getf issue :assignee-id))))) 'vector)
              "user_notes_count" (count-if-not (lambda (n) (getf n :system?)) (getf issue :notes))
              "web_url" (strcat *site-url* (thing-url project issue))))

(defun merge-request-json (project mr)
  (let* ((repository (project-repository project))
         (source (ingot:resolve-commit repository (getf mr :source-branch)))
         (target (ingot:resolve-commit repository (getf mr :target-branch)))
         (status (cond ((not (eq (getf mr :state) :opened)) "cannot_be_merged")
                       ((or (null source) (null target)) "cannot_be_merged")
                       (t (case (ingot:can-merge? repository source target)
                            ((:fast-forward :merge :already) "can_be_merged")
                            (t "cannot_be_merged"))))))
    (json-table "id" (getf mr :id) "iid" (getf mr :iid) "project_id" (getf project :id)
                "title" (getf mr :title) "description" (getf mr :description)
                "state" (status-text (getf mr :state))
                "created_at" (iso-timestamp-ms (getf mr :created))
                "updated_at" (iso-timestamp-ms (or (getf mr :updated) (getf mr :created)))
                "merged_at" (if (getf mr :merged-at) (iso-timestamp-ms (getf mr :merged-at)) :null)
                "closed_at" (if (getf mr :closed-at) (iso-timestamp-ms (getf mr :closed-at)) :null)
                "source_branch" (getf mr :source-branch) "target_branch" (getf mr :target-branch)
                "source_project_id" (getf project :id) "target_project_id" (getf project :id)
                "labels" (coerce (getf mr :labels) 'vector)
                "author" (or (user-json (record :user (getf mr :author-id))) :null)
                "assignee" (or (user-json (record :user (getf mr :assignee-id))) :null)
                "merged_by" (or (user-json (record :user (getf mr :merged-by-id))) :null)
                "merge_commit_sha" (or (getf mr :merge-commit) :null)
                "sha" (or source :null)
                "merge_status" status
                "detailed_merge_status" (if (string= status "can_be_merged") "mergeable" "conflict")
                "has_conflicts" (json-boolean (string= status "cannot_be_merged"))
                "should_remove_source_branch" (json-boolean (getf mr :remove-source-branch?))
                "user_notes_count" (count-if-not (lambda (n) (getf n :system?)) (getf mr :notes))
                "web_url" (strcat *site-url* (thing-url project mr)))))

(defun pipeline-json (project pipeline &key full?)
  (let ((table (json-table "id" (getf pipeline :id) "iid" (getf pipeline :id) "project_id" (getf project :id)
                           "sha" (getf pipeline :sha) "ref" (getf pipeline :ref)
                           "status" (status-text (getf pipeline :status))
                           "source" (status-text (getf pipeline :source))
                           "created_at" (iso-timestamp-ms (getf pipeline :created))
                           "updated_at" (iso-timestamp-ms (or (getf pipeline :updated) (getf pipeline :created)))
                           "web_url" (strcat *site-url* (pipeline-url project pipeline)))))
    (when full?
      (setf (gethash "before_sha" table) "0000000000000000000000000000000000000000"
            (gethash "tag" table) (json-boolean (getf pipeline :tag))
            (gethash "user" table) (or (user-json (record :user (getf pipeline :user-id))) :null)
            (gethash "started_at" table) (if (getf pipeline :started) (iso-timestamp-ms (getf pipeline :started)) :null)
            (gethash "finished_at" table) (if (getf pipeline :finished) (iso-timestamp-ms (getf pipeline :finished)) :null)
            (gethash "duration" table) (or (pipeline-duration pipeline) :null)
            (gethash "yaml_errors" table) (or (getf pipeline :error) :null)
            (gethash "detailed_status" table) (json-table "text" (status-text (getf pipeline :status))
                                                          "label" (status-text (getf pipeline :status)))))
    table))

(defun job-json (project job)
  (let ((pipeline (job-pipeline job)))
    (json-table "id" (getf job :id) "status" (status-text (getf job :status)) "stage" (getf job :stage) "name" (getf job :name)
                "ref" (and pipeline (getf pipeline :ref))
                "tag" (json-boolean (and pipeline (getf pipeline :tag)))
                "allow_failure" (json-boolean (getf job :allow-failure))
                "created_at" (iso-timestamp-ms (getf job :created))
                "started_at" (if (getf job :started) (iso-timestamp-ms (getf job :started)) :null)
                "finished_at" (if (getf job :finished) (iso-timestamp-ms (getf job :finished)) :null)
                "duration" (or (job-duration job) :null)
                "failure_reason" (or (getf job :failure-reason) :null)
                "web_url" (strcat *site-url* (job-url project job))
                "pipeline" (and pipeline (pipeline-json project pipeline))
                "artifacts_file" (if (getf job :artifacts-file)
                                     (json-table "filename" "artifacts.tar" "size" (or (getf job :artifacts-size) 0))
                                     :null)
                "artifacts" (if (getf job :artifacts-file)
                                (vector (json-table "file_type" "archive" "size" (or (getf job :artifacts-size) 0)
                                                    "filename" "artifacts.tar" "file_format" "tar"))
                                #())
                "artifacts_expire_at" (if (getf job :artifacts-expire) (iso-timestamp-ms (getf job :artifacts-expire)) :null)
                "user" (and pipeline (or (user-json (record :user (getf pipeline :user-id))) :null)))))

;;; Paging

(defun page-parameters (req)
  (let ((per (min *per-page-max* (max 1 (or (integer-param req "per_page") *per-page-default*))))
        (page (max 1 (or (integer-param req "page") 1))))
    (values per page)))

(defun respond-page (req ent items json-function)
  "Answer a page of ITEMS as JSON with GitLab's paging headers."
  (multiple-value-bind (per page) (page-parameters req)
    (let* ((total (length items))
           (start (min total (* per (1- page))))
           (end (min total (+ start per)))
           (pages (max 1 (ceiling total per))))
      (respond-json req ent (coerce (mapcar json-function (subseq items start end)) 'vector)
                    :headers (list :x-total total :x-total-pages pages :x-per-page per :x-page page
                                   :x-next-page (if (< page pages) (1+ page) "")
                                   :x-prev-page (if (> page 1) (1- page) ""))))))

;;; Routing

(defun api-dispatch (req ent segments)
  "Serve /api/v4/<segments>."
  (flet ((segment (n) (nth n segments)))
    (cond
      ((null segments) (respond-error-json req ent 404 "404 Not Found"))
      ((string= (segment 0) "version")
       (respond-json req ent (json-table "version" (format nil "~a-anvil" *version*) "revision" *version* "anvil" *version*)))
      ((and (string= (segment 0) "user") (null (rest segments)))
       (let ((user (require-user :read-user)))
         (respond-json req ent (user-json user :full? t))))
      ((string= (segment 0) "users") (api-users req ent (rest segments)))
      ((string= (segment 0) "groups") (api-groups req ent (rest segments)))
      ((string= (segment 0) "projects") (api-projects req ent (rest segments)))
      ((string= (segment 0) "namespaces")
       (respond-page req ent (append (mapcar (lambda (g) (list :group g)) (visible-groups))
                                     (and *current-user* (list (list :user *current-user*))))
                     (lambda (entry)
                       (destructuring-bind (kind record) entry
                         (ecase kind
                           (:group (json-table "id" (getf record :id) "path" (getf record :path)
                                               "full_path" (getf record :full-path) "kind" "group"))
                           (:user (json-table "id" (getf record :id) "path" (getf record :username)
                                              "full_path" (getf record :username) "kind" "user")))))))
      (t (respond-error-json req ent 404 "404 Not Found")))))

(defun api-users (req ent segments)
  (cond ((null segments)
         (let ((search (query-value req "username")))
           (respond-page req ent (if search (remove nil (list (find-user search))) (records :user)) #'user-json)))
        ((every #'digit-char-p (first segments))
         (let ((user (record :user (parse-integer (first segments)))))
           (unless user (not-found "404 User Not Found"))
           (respond-json req ent (user-json user :full? (and *current-user* (or (admin?) (eql (getf user :id) (getf *current-user* :id))))))))
        (t (not-found))))

(defun api-groups (req ent segments)
  (cond ((null segments)
         (respond-page req ent (visible-groups) #'group-json))
        (t (let* ((rest (member-if (lambda (s) (member s '("projects" "members" "subgroups") :test #'string=)) segments))
                  (name-segments (butlast segments (length rest)))
                  (group (or (and (= (length name-segments) 1) (every #'digit-char-p (first name-segments))
                                  (record :group (parse-integer (first name-segments))))
                             (find-group (format nil "~{~a~^/~}" (mapcar #'url-decode name-segments))))))
             (unless (and group (can-read-group? group)) (not-found "404 Group Not Found"))
             (cond ((null rest) (respond-json req ent (group-json group :full? t)))
                   ((string= (first rest) "projects")
                    (let ((search (query-value req "search")))
                      (respond-page req ent (remove-if-not (lambda (p) (and (can-read-project? p)
                                                                            (or (null search) (search (string-downcase search) (string-downcase (getf p :path))))))
                                                           (group-projects group))
                                    #'project-json)))
                   ((string= (first rest) "subgroups") (respond-page req ent (subgroups group) #'group-json))
                   ((string= (first rest) "members")
                    (respond-page req ent (members-with-users group) #'member-json))
                   (t (not-found)))))))

(defun member-json (pair)
  "PAIR is (user . access level), as members-with-users answers."
  (let ((table (user-json (car pair))))
    (setf (gethash "access_level" table) (cdr pair))
    table))

(defun group-json (group &key full?)
  (let ((table (json-table "id" (getf group :id) "name" (getf group :name) "path" (getf group :path)
                           "full_path" (getf group :full-path) "full_name" (getf group :name)
                           "description" (getf group :description)
                           "visibility" (string-downcase (symbol-name (getf group :visibility)))
                           "web_url" (strcat *site-url* (group-url group))
                           "parent_id" (or (getf group :parent-id) :null))))
    (when full?
      (setf (gethash "projects" table) (coerce (mapcar #'project-json (remove-if-not #'can-read-project? (group-projects group))) 'vector)))
    table))

(defun project-from-segments (segments)
  "Two values: the project the leading SEGMENTS name (a number, or a
path up to a resource word), and the segments after it."
  (cond ((null segments) (values nil nil))
        ((every #'digit-char-p (first segments))
         (values (record :project (parse-integer (first segments))) (rest segments)))
        ((position #\/ (url-decode (first segments)))
         (values (find-project (url-decode (first segments))) (rest segments)))
        (t (let ((cut (or (position-if (lambda (s) (member s *project-resources* :test #'string=)) segments) (length segments))))
             (values (find-project (format nil "~{~a~^/~}" (mapcar #'url-decode (subseq segments 0 cut))))
                     (subseq segments cut))))))

(defun api-projects (req ent segments)
  (let ((method (http-method req)))
    (cond
      ((and (null segments) (eq method :get))
       (let* ((search (query-value req "search"))
              (membership? (boolean-param req "membership"))
              (owned? (boolean-param req "owned"))
              (visibility (query-value req "visibility"))
              (projects (remove-if-not
                         (lambda (p)
                           (and (or (null search) (search (string-downcase search) (string-downcase (getf p :path-with-namespace)))
                                    (search (string-downcase search) (string-downcase (getf p :name))))
                                (or (not membership?) (and *current-user* (project-access-level p)))
                                (or (not owned?) (and *current-user* (eql (project-access-level p) 50)))
                                (or (null visibility) (string-equal visibility (symbol-name (getf p :visibility))))))
                         (visible-projects))))
         (respond-page req ent projects (lambda (p) (project-json p :simple? (boolean-param req "simple"))))))
      ((and (null segments) (eq method :post))
       (let* ((user (require-user))
              (name (param req "name")) (path (or (param req "path") (and name (slugify name))))
              (namespace-id (integer-param req "namespace_id")))
         (multiple-value-bind (namespace kind)
             (if namespace-id
                 (let ((group (record :group namespace-id)))
                   (if group (values group :group) (values nil nil)))
                 (values user :user))
           (unless namespace (bad-request "No such namespace."))
           (when (and (eq kind :group) (< (or (group-access-level namespace user) 0) 40)) (forbidden "A Maintainer of the group makes its projects."))
           (let ((project (make-project! namespace kind path :name name :description (param req "description")
                                                            :visibility (let ((v (param req "visibility"))) (if v (intern (string-upcase v) :keyword) *default-visibility*))
                                                            :default-branch (or (param req "default_branch") *default-branch-name*)
                                                            :creator user
                                                            :initialize-with-readme? (boolean-param req "initialize_with_readme"))))
             (respond-json req ent (project-json project) :status 201)))))
      (t
       (multiple-value-bind (project rest) (project-from-segments segments)
         (unless (and project (can-read-project? project)) (respond-error-json req ent 404 "404 Project Not Found") (return-from api-projects nil))
         (api-project req ent project rest))))))

(defun slugify (name)
  (string-trim "-" (ppcre:regex-replace-all "[^a-z0-9._-]+" (string-downcase name) "-")))

(defun api-project (req ent project rest)
  (let ((method (http-method req)))
    (cond
      ((null rest)
       (case method
         (:get (respond-json req ent (project-json project)))
         (:put (require-can :maintain project)
          ;; GitLab's pull mirroring: mirror=true with an import_url sets it, mirror=false clears it
          (cond ((and (param req "mirror") (not (boolean-param req "mirror"))) (clear-pull-mirror! project))
                ((param req "import_url") (set-pull-mirror! project (param req "import_url"))))
          (let ((updated (apply #'update-record! (find-project (getf project :id))
                                (append (when (param req "description") (list :description (param req "description")))
                                        (when (param req "name") (list :name (param req "name")))
                                        (when (param req "visibility") (list :visibility (intern (string-upcase (param req "visibility")) :keyword)))
                                        (when (param req "default_branch")
                                          (ingot:set-default-branch! (project-repository project) (param req "default_branch"))
                                          (list :default-branch (param req "default_branch")))))))
            (respond-json req ent (project-json updated))))
         (:delete (require-can :admin project) (delete-project! project)
          (respond-json req ent (json-table "message" "202 Accepted") :status 202))
         (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
      ((and (equal rest '("mirror" "pull")) (eq method :post))
       (require-can :maintain project)
       (unless (project-pull-mirror project) (bad-request "~a has no pull mirror." (getf project :path-with-namespace)))
       (enqueue-hook! (let ((project (find-project (getf project :id)))) (lambda () (pull-mirror! project))))
       (respond-json req ent (json-table "message" "Pulling.")))
      ((string= (first rest) "repository") (api-repository req ent project (rest rest)))
      ((string= (first rest) "issues") (api-issues req ent project (rest rest)))
      ((string= (first rest) "merge_requests") (api-merge-requests req ent project (rest rest)))
      ((string= (first rest) "pipelines") (api-pipelines req ent project (rest rest)))
      ((string= (first rest) "pipeline")
       (require-can :run-pipeline project)
       (let ((pipeline (run-pipeline! project (or (param req "ref") (getf project :default-branch)) :source :api :user *current-user*
                                      :variables (let ((given (param req "variables")))
                                                   (and (vectorp given)
                                                        (map 'list (lambda (v) (cons (json-get v "key") (json-get v "value"))) given))))))
         (respond-json req ent (pipeline-json project pipeline :full? t) :status 201)))
      ((string= (first rest) "jobs") (api-jobs req ent project (rest rest)))
      ((string= (first rest) "variables") (api-variables req ent project (rest rest)))
      ((string= (first rest) "hooks") (api-hooks req ent project (rest rest)))
      ((string= (first rest) "members")
       ;; GET members (direct), members/all (the namespace's too),
       ;; members/:user_id and members/all/:user_id (one member, as the
       ;; git gate asks before it hosts a project)
       (let* ((all? (equal (second rest) "all"))
              (who (if all? (third rest) (second rest)))
              (members (append (members-with-users project)
                               (when all?
                                 (multiple-value-bind (ns kind) (project-namespace project)
                                   (ecase kind
                                     (:group (members-with-users ns))
                                     (:user (list (cons ns 50)))))))))
         (if who
             (let ((pair (find (ignore-errors (parse-integer who)) members :key (lambda (pair) (getf (car pair) :id)))))
               (unless pair (not-found "No such member."))
               (respond-json req ent (member-json pair)))
             (respond-page req ent members #'member-json))))
      ((string= (first rest) "deployments")
       (respond-page req ent (project-deployments project) #'deployment-json))
      ((string= (first rest) "labels")
       (respond-page req ent (project-labels project) (lambda (label) (json-table "name" label "color" "#428BCA"))))
      ((string= (first rest) "languages") (respond-json req ent (json-table)))
      ((string= (first rest) "star") (require-user) (respond-json req ent (project-json (star-project! project *current-user*)) :status 201))
      ((string= (first rest) "unstar") (require-user) (respond-json req ent (project-json (unstar-project! project *current-user*))))
      (t (respond-error-json req ent 404 "404 Not Found")))))

(defun deployment-json (deployment)
  (json-table "id" (getf deployment :id) "sha" (getf deployment :sha) "status" (getf deployment :state)
              "environment" (json-table "name" (string-downcase (symbol-name (getf deployment :house)))
                                        "external_url" (or (getf deployment :url) :null))
              "created_at" (iso-timestamp-ms (getf deployment :created))
              "updated_at" (iso-timestamp-ms (or (getf deployment :updated) (getf deployment :created)))
              "user" (or (user-json (record :user (getf deployment :user-id))) :null)))

;;; The repository

(defun ref-or-default (req project)
  (or (query-value req "ref") (query-value req "ref_name") (query-value req "sha") (getf project :default-branch)))

(defun api-repository (req ent project rest)
  (let* ((repository (project-repository project))
         (what (first rest)))
    (cond
      ((string= what "tree")
       (let* ((ref (ref-or-default req project))
              (commit (ingot:resolve-commit repository ref))
              (path (string-right-trim "/" (or (query-value req "path") "")))
              (recursive? (boolean-param req "recursive")))
         (unless commit (respond-error-json req ent 404 "404 Tree Not Found") (return-from api-repository nil))
         (let* ((tree-commit (ingot:read-commit repository commit))
                (entry (ingot:tree-entry-at repository (ingot:commit-tree tree-commit) path)))
           (unless (and entry (ingot::tree-entry-tree? entry)) (respond-error-json req ent 404 "404 Tree Not Found") (return-from api-repository nil))
           (let ((entries (if recursive?
                              (ingot:tree-paths repository (ingot:tree-entry-oid entry) :files-only nil)
                              (mapcar (lambda (e) (cons (ingot:tree-entry-name e) e)) (ingot:read-tree repository (ingot:tree-entry-oid entry))))))
             (respond-page req ent entries
                           (lambda (pair) (tree-entry-json (cdr pair) (if (string= path "") (car pair) (format nil "~a/~a" path (car pair))))))))))
      ((string= what "blobs")
       (let* ((oid (second rest))
              (object (and oid (ingot:oid? oid) (ingot:find-object repository oid))))
         (unless (and object (eq (ingot:object-type object) :blob)) (respond-error-json req ent 404 "404 Blob Not Found") (return-from api-repository nil))
         (if (equal (third rest) "raw")
             (respond req ent (ingot:object-data object) :content-type "application/octet-stream" :cache-control "public, max-age=3600")
             (respond-json req ent (json-table "size" (ingot:object-size object) "encoding" "base64" "sha" oid
                                               "content" (cl-base64:usb8-array-to-base64-string (ingot:object-data object)))))))
      ((string= what "files")
       ;; /files/<path, maybe encoded>/raw or /files/<path>
       (let* ((parts (rest rest))
              (raw? (equal (car (last parts)) "raw"))
              (path-parts (if raw? (butlast parts) parts))
              (path (format nil "~{~a~^/~}" (mapcar #'url-decode path-parts)))
              (ref (ref-or-default req project))
              (commit (ingot:resolve-commit repository ref)))
         (unless commit (respond-error-json req ent 404 "404 Commit Not Found") (return-from api-repository nil))
         (multiple-value-bind (data entry) (ingot:blob-at repository commit path)
           (unless data (respond-error-json req ent 404 "404 File Not Found") (return-from api-repository nil))
           (if raw?
               (respond req ent data :content-type (content-type-for path) :cache-control "no-cache"
                                     :headers (list :x-gitlab-blob-id (ingot:tree-entry-oid entry) :x-gitlab-size (length data)
                                                    :x-gitlab-ref ref :x-gitlab-commit-id commit))
               (respond-json req ent (json-table "file_name" (ingot::last-path-part path) "file_path" path "size" (length data)
                                                 "encoding" "base64" "content" (cl-base64:usb8-array-to-base64-string data)
                                                 "ref" ref "blob_id" (ingot:tree-entry-oid entry) "commit_id" commit
                                                 "last_commit_id" commit))))))
      ((string= what "branches")
       (cond ((and (null (rest rest)) (eq (http-method req) :get))
              (respond-page req ent (ingot:branches repository)
                            (lambda (pair) (branch-json project repository (car pair) (cdr pair)))))
             ((eq (http-method req) :post)
              (require-can :push project)
              (let* ((name (param req "branch")) (ref (param req "ref"))
                     (oid (and ref (ingot:resolve-commit repository ref))))
                (unless (and name oid) (bad-request "branch and ref."))
                (handler-case (ingot:update-ref! repository (format nil "refs/heads/~a" name) oid :old nil)
                  (ingot:ref-conflict () (bad-request "The branch ~a exists." name))
                  (ingot:git-error (e) (bad-request "~a" e)))
                (respond-json req ent (branch-json project repository name oid) :status 201)))
             (t (let* ((name (format nil "~{~a~^/~}" (mapcar #'url-decode (rest rest))))
                       (oid (ingot:ref-value* repository (format nil "refs/heads/~a" name))))
                  (cond ((null oid) (respond-error-json req ent 404 "404 Branch Not Found"))
                        ((eq (http-method req) :delete)
                         (require-can :push project)
                         (when (protected-branch? project name) (forbidden "A protected branch."))
                         (ingot:delete-ref! repository (format nil "refs/heads/~a" name))
                         (respond req ent "" :status 204))
                        (t (respond-json req ent (branch-json project repository name oid))))))))
      ((string= what "tags")
       (respond-page req ent (ingot:tags repository)
                     (lambda (pair)
                       (let* ((object (ingot:find-object repository (cdr pair)))
                              (tag (and object (eq (ingot:object-type object) :tag) (ingot:parse-tag (ingot:object-data object) (cdr pair))))
                              (commit-oid (ingot:peel-to-commit repository (cdr pair))))
                         (json-table "name" (car pair) "target" (cdr pair)
                                     "message" (if tag (ingot::tag-message tag) :null)
                                     "commit" (if commit-oid (commit-json project (ingot:read-commit repository commit-oid)) :null)
                                     "protected" 'yason:false)))))
      ((string= what "commits")
       (cond ((and (null (rest rest)) (eq (http-method req) :get))
              (let* ((ref (ref-or-default req project))
                     (start (ingot:resolve-commit repository ref))
                     (path (query-value req "path"))
                     (since (parse-iso-timestamp (query-value req "since")))
                     (until (parse-iso-timestamp (query-value req "until"))))
                (unless start (respond-error-json req ent 404 "404 Commit Not Found") (return-from api-repository nil))
                (multiple-value-bind (per page) (page-parameters req)
                  (let ((commits (ingot:log-commits repository start :limit per :skip (* per (1- page)) :path path
                                                                     :since (and since (unix-time since)) :until (and until (unix-time until)))))
                    (respond-json req ent (coerce (mapcar (lambda (c) (commit-json project c)) commits) 'vector)
                                  :headers (list :x-per-page per :x-page page :x-next-page (if (= (length commits) per) (1+ page) "")))))))
             ((and (null (rest rest)) (eq (http-method req) :post))
              (api-create-commit req ent project repository))
             (t (let* ((sha (ingot:resolve-commit repository (url-decode (second rest))))
                       (commit (and sha (ingot:read-commit repository sha))))
                  (unless commit (respond-error-json req ent 404 "404 Commit Not Found") (return-from api-repository nil))
                  (cond ((null (cddr rest))
                         (let ((changes (ingot::commit-diff repository sha)))
                           (respond-json req ent (commit-json project commit
                                                              :stats (json-table "additions" 0 "deletions" 0 "total" (length changes))))))
                        ((string= (third rest) "diff")
                         (respond-json req ent (coerce (mapcar (lambda (change) (change-json repository change)) (ingot::commit-diff repository sha)) 'vector)))
                        ((string= (third rest) "refs")
                         (respond-json req ent (coerce (loop for (name . oid) in (ingot:branches repository)
                                                             when (ingot:ancestor? repository sha oid)
                                                               collect (json-table "type" "branch" "name" name))
                                                       'vector)))
                        (t (respond-error-json req ent 404 "404 Not Found")))))))
      ((starts-with? "archive" what)
       (let* ((format-text (cond ((starts-with? "archive." what) (subseq what 8))
                                 ((second rest) (second rest))
                                 (t "tar.gz")))
              (ref (ref-or-default req project))
              (sha (ingot:resolve-commit repository ref)))
         (unless sha (respond-error-json req ent 404 "404 Commit Not Found") (return-from api-repository nil))
         (serve-archive req ent project repository sha ref format-text)))
      ((string= what "compare")
       (let* ((from (ingot:resolve-commit repository (query-value req "from" "")))
              (to (ingot:resolve-commit repository (query-value req "to" ""))))
         (unless (and from to) (bad-request "from and to."))
         (let ((changes (ingot:tree-diff repository (ingot:commit-tree (ingot:read-commit repository from))
                                         (ingot:commit-tree (ingot:read-commit repository to)))))
           (respond-json req ent (json-table "commit" (commit-json project (ingot:read-commit repository to))
                                             "commits" (coerce (mapcar (lambda (c) (commit-json project c))
                                                                       (remove-if (lambda (c) (ingot:ancestor? repository (ingot:commit-oid c) from))
                                                                                  (ingot:log-commits repository to :limit 100)))
                                                               'vector)
                                             "diffs" (coerce (mapcar (lambda (change) (change-json repository change)) changes) 'vector)
                                             "compare_timeout" 'yason:false "compare_same_ref" (json-boolean (string= from to)))))))
      (t (respond-error-json req ent 404 "404 Not Found")))))

(defun serve-archive (req ent project repository sha ref format-text)
  (let* ((name (format nil "~a-~a" (getf project :path) (ref-slug (if (ingot:oid? ref) (subseq ref 0 8) ref))))
         (tree (ingot:commit-tree (ingot:read-commit repository sha))))
    (cond ((string= format-text "zip")
           (respond req ent (ingot:zip-tree repository tree :prefix (strcat name "/"))
                    :content-type "application/zip"
                    :headers (list :content-disposition (format nil "attachment; filename=\"~a.zip\"" name))))
          ((string= format-text "tar")
           (respond req ent (ingot::buffer-octets (ingot:tar-tree repository tree :prefix (strcat name "/")))
                    :content-type "application/x-tar"
                    :headers (list :content-disposition (format nil "attachment; filename=\"~a.tar\"" name))))
          (t (respond req ent (ingot:tar-gz-tree repository tree :prefix (strcat name "/"))
                      :content-type "application/gzip"
                      :headers (list :content-disposition (format nil "attachment; filename=\"~a.tar.gz\"" name)))))))

(defun change-json (repository change)
  (let* ((old-data (and (ingot::change-old-oid change) (ignore-errors (ingot:read-blob repository (ingot::change-old-oid change)))))
         (new-data (and (ingot::change-new-oid change) (ignore-errors (ingot:read-blob repository (ingot::change-new-oid change)))))
         (binary? (or (and old-data (ingot:binary-octets? old-data)) (and new-data (ingot:binary-octets? new-data)))))
    (json-table "old_path" (ingot::change-path change) "new_path" (ingot::change-path change)
                "a_mode" (or (ingot::change-old-mode change) "0") "b_mode" (or (ingot::change-new-mode change) "0")
                "new_file" (json-boolean (eq (ingot::change-status change) :added))
                "renamed_file" 'yason:false
                "deleted_file" (json-boolean (eq (ingot::change-status change) :deleted))
                "diff" (if binary?
                           "Binary files differ\n"
                           (ingot:unified-diff (if old-data (ingot:octets-to-string old-data) "")
                                               (if new-data (ingot:octets-to-string new-data) "")
                                               :old-name (strcat "a/" (ingot::change-path change)) :new-name (strcat "b/" (ingot::change-path change)))))))

(defun api-create-commit (req ent project repository)
  "POST /repository/commits: branch, start_branch, commit_message,
actions [{action, file_path, previous_path, content, encoding,
execute_filemode}], as GitLab takes them."
  (require-user)
  (let* ((branch (param req "branch")) (start (param req "start_branch"))
         (message (param req "commit_message"))
         (actions (param req "actions")))
    (unless (and branch message (vectorp actions) (plusp (length actions))) (bad-request "branch, commit_message and actions."))
    (unless (can-push-branch? project branch) (forbidden "You may not push to this branch."))
    (unless (or (ingot:ref-value* repository (format nil "refs/heads/~a" branch))
                (and start (ingot:ref-value* repository (format nil "refs/heads/~a" start)))
                (null (ingot:head-oid repository)))
      (bad-request "No branch ~a; name a start_branch to make it from." branch))
    (let ((converted
            (map 'list (lambda (action)
                         (let* ((kind (intern (string-upcase (or (json-get action "action") "create")) :keyword))
                                (content (json-get action "content"))
                                (content (if (and content (equal (json-get action "encoding") "base64"))
                                             (cl-base64:base64-string-to-usb8-array content)
                                             content)))
                           (unless (member kind '(:create :update :delete :move :chmod)) (bad-request "action: ~a" kind))
                           (unless (ingot::valid-ref-name? (strcat "x/" (or (json-get action "file_path") ""))) (bad-request "file_path."))
                           (append (list :action kind :path (json-get action "file_path"))
                                   (when content (list :content content))
                                   (when (json-get action "previous_path") (list :previous-path (json-get action "previous_path")))
                                   (when (json-get action "execute_filemode")
                                     (list :mode (if (member (json-get action "execute_filemode") '(t yason:true "true") :test #'equal) "100755" "100644"))))))
                 actions)))
      (let ((oid (handler-case (ingot:make-commit! repository :branch branch :start-branch start :actions converted
                                                               :message message :author (project-committer *current-user*))
                   (ingot:git-error (e) (bad-request "~a" e)))))
        (after-push! project *current-user*
                     (list (ingot::make-ref-command :old "" :new oid :name (format nil "refs/heads/~a" branch) :status :ok)))
        (respond-json req ent (commit-json project (ingot:read-commit repository oid)) :status 201)))))

;;; Issues and merge requests

(defun state-param (req)
  (let ((state (query-value req "state")))
    (cond ((null state) :all) ((string= state "opened") :opened) ((string= state "closed") :closed) ((string= state "merged") :merged) (t :all))))

(defun api-issues (req ent project rest)
  (cond ((null rest)
         (case (http-method req)
           (:get (respond-page req ent (project-issues project :state (state-param req)
                                                                :labels (and (query-value req "labels") (split-on (query-value req "labels") #\,)))
                               (lambda (issue) (issue-json project issue))))
           (:post (require-can :create-issue project)
            (let ((issue (make-issue! project *current-user* (param req "title")
                                      :description (param req "description")
                                      :labels (let ((labels (param req "labels"))) (if (stringp labels) (split-on labels #\,) (and (vectorp labels) (coerce labels 'list))))
                                      :assignee-id (integer-param req "assignee_id"))))
              (deliver-thing-hooks! project issue *current-user* "open")
              (respond-json req ent (issue-json project issue) :status 201)))
           (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
        (t (let ((issue (and (every #'digit-char-p (first rest)) (find-issue project (parse-integer (first rest))))))
             (unless issue (respond-error-json req ent 404 "404 Issue Not Found") (return-from api-issues nil))
             (cond ((null (rest rest))
                    (case (http-method req)
                      (:get (respond-json req ent (issue-json project issue)))
                      (:put (require-can :update-issue project)
                       (respond-json req ent (issue-json project (update-thing-from-params! project issue req))))
                      (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
                   ((string= (second rest) "notes")
                    (case (http-method req)
                      (:get (respond-page req ent (getf issue :notes) #'note-json))
                      (:post (require-can :create-note project)
                       (let ((updated (add-note! issue *current-user* (param req "body"))))
                         (respond-json req ent (note-json (car (last (getf updated :notes)))) :status 201)))
                      (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
                   (t (respond-error-json req ent 404 "404 Not Found")))))))

(defun update-thing-from-params! (project thing req)
  (let ((state-event (param req "state_event")))
    (let ((updated (apply #'update-record! thing
                          (append (when (param req "title") (list :title (param req "title")))
                                  (when (param req "description") (list :description (param req "description")))
                                  (when (param req "labels") (list :labels (let ((labels (param req "labels")))
                                                                             (if (stringp labels) (split-on labels #\,) (coerce labels 'list)))))
                                  (when (member "assignee_id" (and (request-json-cached req) (loop for k being the hash-keys of (request-json-cached req) collect k)) :test #'equal)
                                    (list :assignee-id (integer-param req "assignee_id")))))))
      (cond ((equal state-event "close") (setq updated (close-thing! updated *current-user*))
             (deliver-thing-hooks! project updated *current-user* "close"))
            ((equal state-event "reopen") (setq updated (reopen-thing! updated *current-user*))
             (deliver-thing-hooks! project updated *current-user* "reopen"))
            (t (deliver-thing-hooks! project updated *current-user* "update")))
      updated)))

(defun api-merge-requests (req ent project rest)
  (cond ((null rest)
         (case (http-method req)
           (:get (respond-page req ent (project-merge-requests project :state (state-param req) :source-branch (query-value req "source_branch"))
                               (lambda (mr) (merge-request-json project mr))))
           (:post (require-can :create-merge-request project)
            (let ((mr (make-merge-request! project *current-user* (param req "title")
                                           (param req "source_branch") (param req "target_branch")
                                           :description (param req "description")
                                           :labels (let ((labels (param req "labels"))) (if (stringp labels) (split-on labels #\,) (and (vectorp labels) (coerce labels 'list))))
                                           :remove-source-branch? (boolean-param req "remove_source_branch"))))
              (deliver-thing-hooks! project mr *current-user* "open")
              (respond-json req ent (merge-request-json project mr) :status 201)))
           (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
        (t (let ((mr (and (every #'digit-char-p (first rest)) (find-merge-request project (parse-integer (first rest))))))
             (unless mr (respond-error-json req ent 404 "404 Merge Request Not Found") (return-from api-merge-requests nil))
             (cond ((null (rest rest))
                    (case (http-method req)
                      (:get (respond-json req ent (merge-request-json project mr)))
                      (:put (require-can :update-issue project)
                       (respond-json req ent (merge-request-json project (update-thing-from-params! project mr req))))
                      (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
                   ((string= (second rest) "notes")
                    (case (http-method req)
                      (:get (respond-page req ent (getf mr :notes) #'note-json))
                      (:post (require-can :create-note project)
                       (let ((updated (add-note! mr *current-user* (param req "body"))))
                         (respond-json req ent (note-json (car (last (getf updated :notes)))) :status 201)))
                      (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
                   ((string= (second rest) "merge")
                    (require-can :merge project)
                    (let ((merged (merge-merge-request! project mr *current-user*
                                                        :message (param req "merge_commit_message")
                                                        :remove-source? (boolean-param req "should_remove_source_branch"))))
                      (respond-json req ent (merge-request-json project merged))))
                   ((string= (second rest) "changes")
                    (let ((table (merge-request-json project mr)))
                      (setf (gethash "changes" table) (coerce (mapcar (lambda (c) (change-json (project-repository project) c)) (merge-request-changes project mr)) 'vector))
                      (respond-json req ent table)))
                   ((string= (second rest) "commits")
                    (respond-json req ent (coerce (mapcar (lambda (c) (commit-json project c)) (merge-request-commits project mr)) 'vector)))
                   (t (respond-error-json req ent 404 "404 Not Found")))))))

(defun merge-request-base (project mr)
  (let* ((repository (project-repository project))
         (source (ingot:resolve-commit repository (getf mr :source-branch)))
         (target (ingot:resolve-commit repository (getf mr :target-branch))))
    (values repository source target (and source target (ingot:merge-base repository source target)))))

(defun merge-request-changes (project mr)
  (multiple-value-bind (repository source target base) (merge-request-base project mr)
    (if (and source target)
        (ingot:tree-diff repository (ingot:commit-tree (ingot:read-commit repository (or base target)))
                         (ingot:commit-tree (ingot:read-commit repository source)))
        nil)))

(defun merge-request-commits (project mr)
  (multiple-value-bind (repository source target) (merge-request-base project mr)
    (if (and source target)
        (remove-if (lambda (c) (ingot:ancestor? repository (ingot:commit-oid c) target))
                   (ingot:log-commits repository source :limit 200))
        nil)))

(defun merge-merge-request! (project mr user &key message remove-source?)
  "Merge MR; answers the updated record.  Signals http-error 406 on a
conflict, as GitLab does."
  (unless (eq (getf mr :state) :opened) (http-error 405 "The merge request is not open."))
  (let ((repository (project-repository project)))
    (unless (can-push-branch? project (getf mr :target-branch) user) (forbidden "You may not merge into this branch."))
    (handler-case
        (let ((oid (ingot:merge-branches! repository (getf mr :source-branch) (getf mr :target-branch)
                                          :author (project-committer user)
                                          :message (or message (format nil "Merge branch '~a' into '~a'~%~%~a~%~%See merge request !~d"
                                                                       (getf mr :source-branch) (getf mr :target-branch) (getf mr :title) (getf mr :iid)))
                                          :allow-fast-forward nil)))
          (let ((updated (add-note! (update-record! mr :state :merged :merge-commit oid :merged-by-id (getf user :id) :merged-at (get-universal-time))
                                    user (format nil "merged as ~a" (subseq oid 0 8)) :system? t)))
            (when (or remove-source? (getf mr :remove-source-branch?))
              (unless (or (string= (getf mr :source-branch) (getf project :default-branch)) (protected-branch? project (getf mr :source-branch)))
                (ignore-errors (ingot:delete-ref! repository (format nil "refs/heads/~a" (getf mr :source-branch))))))
            (after-push! project user (list (ingot::make-ref-command :old "" :new oid :name (format nil "refs/heads/~a" (getf mr :target-branch)) :status :ok)))
            (deliver-thing-hooks! project updated user "merge")
            updated))
      (ingot::merge-conflict (e) (http-error 406 "~a" e))
      (ingot:git-error (e) (http-error 406 "~a" e)))))

;;; CI

(defun api-pipelines (req ent project rest)
  (cond ((null rest)
         (respond-page req ent (let ((ref (query-value req "ref")) (status (query-value req "status")) (sha (query-value req "sha")))
                                 (remove-if-not (lambda (p) (and (or (null ref) (equal (getf p :ref) ref))
                                                                 (or (null sha) (equal (getf p :sha) sha))
                                                                 (or (null status) (string-equal status (status-text (getf p :status))))))
                                                (project-pipelines project)))
                       (lambda (p) (pipeline-json project p))))
        (t (let ((pipeline (and (every #'digit-char-p (first rest)) (record :pipeline (parse-integer (first rest))))))
             (unless (and pipeline (eql (getf pipeline :project-id) (getf project :id)))
               (respond-error-json req ent 404 "404 Pipeline Not Found") (return-from api-pipelines nil))
             (cond ((null (rest rest))
                    (if (eq (http-method req) :delete)
                        (progn (require-can :maintain project) (cancel-pipeline! pipeline)
                               (dolist (job (pipeline-jobs pipeline)) (delete-record! job))
                               (delete-record! pipeline) (respond req ent "" :status 204))
                        (respond-json req ent (pipeline-json project pipeline :full? t))))
                   ((string= (second rest) "jobs")
                    (respond-page req ent (let ((scope (query-values req "scope[]")))
                                            (remove-if-not (lambda (j) (or (null scope) (member (status-text (getf j :status)) scope :test #'string=)))
                                                           (pipeline-jobs pipeline)))
                                  (lambda (j) (job-json project j))))
                   ((string= (second rest) "cancel") (require-can :run-pipeline project)
                    (respond-json req ent (pipeline-json project (cancel-pipeline! pipeline) :full? t)))
                   ((string= (second rest) "retry") (require-can :run-pipeline project)
                    (dolist (job (pipeline-jobs pipeline))
                      (when (member (getf job :status) '(:failed :canceled)) (retry-job! job)))
                    (respond-json req ent (pipeline-json project (record :pipeline (getf pipeline :id)) :full? t)))
                   ((string= (second rest) "variables")
                    (respond-json req ent (coerce (mapcar (lambda (v) (json-table "key" (car v) "value" (cdr v) "variable_type" "env_var"))
                                                          (remove-if (lambda (v) (find (car v) (project-variables project) :key (lambda (pv) (getf pv :key)) :test #'string=))
                                                                     (getf pipeline :variables)))
                                                  'vector)))
                   (t (respond-error-json req ent 404 "404 Not Found")))))))

(defun api-jobs (req ent project rest)
  (cond ((null rest)
         (respond-page req ent (records :job (lambda (j) (eql (getf j :project-id) (getf project :id)))) (lambda (j) (job-json project j))))
        ((string= (first rest) "artifacts")
         ;; /jobs/artifacts/:ref/download?job=name  or  /jobs/artifacts/:ref/raw/<path>?job=name
         (let* ((name (query-value req "job"))
                (ref (url-decode (second rest)))
                (mode (third rest))
                (job (latest-artifacts-job project ref name)))
           (unless job (respond-error-json req ent 404 "404 Not Found") (return-from api-jobs nil))
           (if (equal mode "raw")
               (serve-artifact-file req ent job (format nil "~{~a~^/~}" (mapcar #'url-decode (cdddr rest))))
               (serve-artifacts req ent job))))
        (t (let ((job (and (every #'digit-char-p (first rest)) (record :job (parse-integer (first rest))))))
             (unless (and job (eql (getf job :project-id) (getf project :id))) (respond-error-json req ent 404 "404 Job Not Found") (return-from api-jobs nil))
             (cond ((null (rest rest)) (respond-json req ent (job-json project job)))
                   ((string= (second rest) "trace")
                    (respond req ent (read-trace job) :content-type "text/plain; charset=utf-8" :cache-control "no-store"))
                   ((string= (second rest) "artifacts")
                    (if (cddr rest)
                        (serve-artifact-file req ent job (format nil "~{~a~^/~}" (mapcar #'url-decode (cddr rest))))
                        (serve-artifacts req ent job)))
                   ((string= (second rest) "retry") (require-can :run-pipeline project)
                    (respond-json req ent (job-json project (retry-job! job)) :status 201))
                   ((string= (second rest) "play") (require-can :run-pipeline project)
                    (respond-json req ent (job-json project (or (play-job! job) job))))
                   ((string= (second rest) "cancel") (require-can :run-pipeline project)
                    (set-job-status! job :canceled)
                    (respond-json req ent (job-json project (record :job (getf job :id)))))
                   (t (respond-error-json req ent 404 "404 Not Found")))))))

(defun latest-artifacts-job (project ref name)
  "The newest successful job named NAME of a pipeline on REF with artifacts."
  (dolist (pipeline (project-pipelines project :ref ref))
    (when (eq (getf pipeline :status) :success)
      (let ((job (find-if (lambda (j) (and (string= (getf j :name) name) (eq (getf j :status) :success) (getf j :artifacts-file)))
                          (pipeline-jobs pipeline))))
        (when job (return job))))))

(defun serve-artifacts (req ent job)
  (let ((file (and (getf job :artifacts-file) (probe-file (getf job :artifacts-file)))))
    (unless file (respond-error-json req ent 404 "404 Not Found") (return-from serve-artifacts nil))
    (respond req ent (ingot:read-file-octets file) :content-type "application/x-tar"
             :headers (list :content-disposition (format nil "attachment; filename=\"artifacts-~d.tar\"" (getf job :id))))))

(defun serve-artifact-file (req ent job path)
  (let ((file (and (getf job :artifacts-file) (probe-file (getf job :artifacts-file)))))
    (unless file (respond-error-json req ent 404 "404 Not Found") (return-from serve-artifact-file nil))
    (let ((data (ingot:tar-find (ingot:read-file-octets file) path)))
      (unless data (respond-error-json req ent 404 "404 Not Found") (return-from serve-artifact-file nil))
      (respond req ent data :content-type (content-type-for path) :cache-control "public, max-age=600"))))

(defun api-variables (req ent project rest)
  (require-can :read-variables project)
  (cond ((null rest)
         (case (http-method req)
           (:get (respond-page req ent (getf project :variables) #'variable-json))
           (:post (let ((key (param req "key")) (value (param req "value")))
                    (unless (and key value (ppcre:scan "^[A-Za-z_][A-Za-z0-9_]*$" key)) (bad-request "key and value."))
                    (set-variable! project key value :masked? (boolean-param req "masked") :protected? (boolean-param req "protected"))
                    (respond-json req ent (variable-json (find key (getf (find-project (getf project :id)) :variables) :key (lambda (v) (getf v :key)) :test #'string=)) :status 201)))
           (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
        (t (let ((variable (find (first rest) (getf project :variables) :key (lambda (v) (getf v :key)) :test #'string=)))
             (unless variable (respond-error-json req ent 404 "404 Variable Not Found") (return-from api-variables nil))
             (case (http-method req)
               (:get (respond-json req ent (variable-json variable)))
               (:put (set-variable! project (first rest) (or (param req "value") (getf variable :value))
                                    :masked? (boolean-param req "masked" (getf variable :masked?)) :protected? (boolean-param req "protected" (getf variable :protected?)))
                (respond-json req ent (variable-json (find (first rest) (getf (find-project (getf project :id)) :variables) :key (lambda (v) (getf v :key)) :test #'string=))))
               (:delete (set-variable! project (first rest) nil) (respond req ent "" :status 204))
               (t (respond-error-json req ent 405 "405 Method Not Allowed")))))))

(defun variable-json (variable)
  (json-table "key" (getf variable :key) "value" (if (getf variable :masked?) "[masked]" (getf variable :value))
              "variable_type" "env_var" "masked" (json-boolean (getf variable :masked?))
              "protected" (json-boolean (getf variable :protected?))))

(defun api-hooks (req ent project rest)
  (require-can :maintain project)
  (cond ((null rest)
         (case (http-method req)
           (:get (respond-page req ent (getf project :hooks) #'hook-json))
           (:post (let ((url (param req "url")))
                    (unless (and url (starts-with? "http" url)) (bad-request "url."))
                    (let ((events (remove nil (list (and (boolean-param req "push_events" t) "push")
                                                    (and (boolean-param req "tag_push_events") "tag_push")
                                                    (and (boolean-param req "issues_events") "issue")
                                                    (and (boolean-param req "merge_requests_events") "merge_request")
                                                    (and (boolean-param req "pipeline_events") "pipeline")))))
                      (add-hook! project url :token (param req "token") :events events)
                      (respond-json req ent (hook-json (car (last (getf (find-project (getf project :id)) :hooks)))) :status 201))))
           (t (respond-error-json req ent 405 "405 Method Not Allowed"))))
        (t (let ((hook (find (ignore-errors (parse-integer (first rest))) (getf project :hooks) :key (lambda (h) (getf h :id)))))
             (unless hook (respond-error-json req ent 404 "404 Hook Not Found") (return-from api-hooks nil))
             (case (http-method req)
               (:get (respond-json req ent (hook-json hook)))
               (:delete (remove-hook! project (getf hook :id)) (respond req ent "" :status 204))
               (t (respond-error-json req ent 405 "405 Method Not Allowed")))))))

(defun hook-json (hook)
  (json-table "id" (getf hook :id) "url" (getf hook :url)
              "push_events" (json-boolean (member "push" (getf hook :events) :test #'string=))
              "tag_push_events" (json-boolean (member "tag_push" (getf hook :events) :test #'string=))
              "issues_events" (json-boolean (member "issue" (getf hook :events) :test #'string=))
              "merge_requests_events" (json-boolean (member "merge_request" (getf hook :events) :test #'string=))
              "pipeline_events" (json-boolean (member "pipeline" (getf hook :events) :test #'string=))
              "created_at" (iso-timestamp-ms (getf hook :created))
              "last_status" (or (getf hook :last-status) :null)))

;;; Content types

(defparameter *content-types*
  '(("html" . "text/html; charset=utf-8") ("htm" . "text/html; charset=utf-8") ("css" . "text/css; charset=utf-8")
    ("js" . "text/javascript; charset=utf-8") ("json" . "application/json; charset=utf-8") ("xml" . "application/xml")
    ("txt" . "text/plain; charset=utf-8") ("md" . "text/plain; charset=utf-8") ("lisp" . "text/plain; charset=utf-8")
    ("asd" . "text/plain; charset=utf-8") ("sexp" . "text/plain; charset=utf-8") ("yml" . "text/plain; charset=utf-8")
    ("yaml" . "text/plain; charset=utf-8") ("sh" . "text/plain; charset=utf-8")
    ("png" . "image/png") ("jpg" . "image/jpeg") ("jpeg" . "image/jpeg") ("gif" . "image/gif") ("svg" . "image/svg+xml")
    ("ico" . "image/x-icon") ("webp" . "image/webp") ("pdf" . "application/pdf") ("zip" . "application/zip")
    ("gz" . "application/gzip") ("tar" . "application/x-tar") ("woff2" . "font/woff2") ("woff" . "font/woff")
    ("ttf" . "font/ttf") ("wasm" . "application/wasm") ("mp4" . "video/mp4") ("webm" . "video/webm")))

(defun content-type-for (path)
  (let* ((dot (position #\. path :from-end t))
         (type (and dot (string-downcase (subseq path (1+ dot))))))
    (or (cdr (assoc type *content-types* :test #'equal)) "application/octet-stream")))
